# Optional. Leave empty to run RSVP in WhatsApp-only mode (nothing is stored).
# These two values are PUBLIC by design (Supabase "anon" key). Safety comes from
# Row Level Security in supabase/schema.sql (guests can INSERT only, never read).
# NEVER put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL used for WhatsApp/Open Graph preview image (no trailing slash)
VITE_SITE_URL=
